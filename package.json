{
  "name": "jannat-alrahman",
  "version": "1.0.0",
  "description": "Islamic learning app for Quran, Adhkar, and spiritual tracking",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .js,.vue,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.vue,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,vue,ts,tsx,json,css,scss}\""
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "tweetnacl": "^1.0.3",
    "dompurify": "^3.0.8",
    "chart.js": "^4.4.0",
    "vue-chartjs": "^5.3.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.1",
    "@vitest/ui": "^1.0.4",
    "typescript": "^5.3.3",
    "vue-tsc": "^1.8.22",
    "vite": "^5.0.7",
    "tailwindcss": "^3.3.6",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "sass": "^1.69.5",
    "vitest": "^1.0.4",
    "@playwright/test": "^1.40.1",
    "eslint": "^8.55.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint-plugin-vue": "^9.19.2",
    "prettier": "^3.1.0",
    "@heroicons/vue": "^2.0.18"
  },
  "keywords": [
    "quran",
    "islamic",
    "adhkar",
    "dua",
    "tracker",
    "habit",
    "spiritual",
    "vue3"
  ],
  "author": "Saudir Adiom OSS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saudiradiom-oss/jannat-alrahman.git"
  },
  "bugs": {
    "url": "https://github.com/saudiradiom-oss/jannat-alrahman/issues"
  },
  "homepage": "https://github.com/saudiradiom-oss/jannat-alrahman#readme"
}
